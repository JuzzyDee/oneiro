# wrangler.toml.example — template for the Cloudflare Workers deploy.
#
# THIS FILE IS A TEMPLATE. Run `./scripts/setup.sh` from the repo root
# and it will:
#
#   1. Copy this file to `wrangler.toml`
#   2. Create the Cloudflare resources (D1, Vectorize, KV, R2)
#   3. Replace the CHANGE_ME_AFTER_SETUP placeholders below with the
#      real resource IDs returned by wrangler
#   4. Generate the OAuth credentials and admin key
#   5. Push everything to your Cloudflare account
#   6. Deploy the worker
#
# Manual deploy (if you'd rather not run the script): copy this file
# to `wrangler.toml` and follow the steps in the README's "Manual
# deploy" appendix.
#
# `wrangler.toml` itself is gitignored — it holds your account-specific
# resource IDs and you don't want to commit them or pull a teammate's
# accidentally.

name = "oneiro"
main = "build/worker/shim.mjs"
compatibility_date = "2026-05-01"

[build]
# Rust workers compile to wasm32 via worker-build (installs on demand).
# Requires the `wasm32-unknown-unknown` target installed via rustup.
# Pinned to 0.8.4: 0.8.5 passes `--force-enable-abort-handler` to wasm-bindgen,
# which the 0.2.123 CLI (the ceiling `worker = "0.8"` allows) doesn't support.
# Revisit when the `worker` crate is bumped.
command = "cargo install -q worker-build --version 0.8.4 && worker-build --release"

# ──────────────────────────────────────────────────────────────────────
# D1 — primary memory store. Replaces the local SQLite file.
# Schema lives in `migrations/`.
# ──────────────────────────────────────────────────────────────────────
[[d1_databases]]
binding = "DB"
database_name = "oneiro-db"
database_id = "CHANGE_ME_AFTER_SETUP"

# ──────────────────────────────────────────────────────────────────────
# Vectorize — vector index for semantic recall. bge-base-en-v1.5
# produces 768-dim vectors; cosine similarity matches what the
# embedding code expects.
# ──────────────────────────────────────────────────────────────────────
[[vectorize]]
binding = "VECTORS"
index_name = "oneiro-vectors"

# ──────────────────────────────────────────────────────────────────────
# Workers AI — bge-base-en-v1.5 embeddings.
# ──────────────────────────────────────────────────────────────────────
[ai]
binding = "AI"

# ──────────────────────────────────────────────────────────────────────
# R2 — content-addressed image storage. Keys are `{hash}.{ext}`.
#
# OPTIONAL: image features (remember_with_image, recall_image, rover
# camera heartbeats) need R2. The worker detects the IMAGES binding at
# runtime — if absent, those tools are hidden from the MCP listing and
# every other feature works normally.
#
# R2 is the only stack component that requires CF billing to be enabled
# on the account (even within the 10GB free tier). Comment this block
# in if you want image storage; leave it out for a truly billing-free
# deploy. The setup script will ask which path you want.
# ──────────────────────────────────────────────────────────────────────
# [[r2_buckets]]
# binding = "IMAGES"
# bucket_name = "oneiro-images"

# ──────────────────────────────────────────────────────────────────────
# KV — OAuth access tokens with TTL.
# ──────────────────────────────────────────────────────────────────────
[[kv_namespaces]]
binding = "TOKENS"
id = "CHANGE_ME_AFTER_SETUP"

# ──────────────────────────────────────────────────────────────────────
# KV — Update-check cache (CLA-102). The recall handler fetches
# VERSION.json from GitHub raw at most every 6h and caches the result
# here. Drives the "update available" prompt attached to recall output.
# ──────────────────────────────────────────────────────────────────────
[[kv_namespaces]]
binding = "VERSION_CACHE"
id = "CHANGE_ME_AFTER_SETUP"

# ──────────────────────────────────────────────────────────────────────
# Cron triggers — the nightly cognitive-write roster (CLA-134/125/128). All three
# run under the single shared `cognitive` lease (single-flight), staggered so they
# never overlap, and CSCC cleans the semantic layer before orient distils it.
#
#   CSCC defrag (CLA-134)
#     Whole-store cosine-cluster consolidation — merges near-duplicate semantics.
#     Default: 14:00 UTC (= 00:00 AEST). The setup script rewrites this for your TZ.
#
#   orient-run (CLA-125)
#     Semantic → orientation distillation + the whittle re-settle.
#     Default: 14:30 UTC (= 00:30 AEST), staggered 30m after CSCC.
#
#   Dialectic (CLA-128)
#     Anti-mythology pass over the always-loaded orientation layer (adversarial,
#     reversible). Default: 08:00 UTC (= 18:00 AEST).
#
# Hebbian REM (the old CLA-87 loop) is RETIRED — CSCC replaced it; no longer scheduled.
# Cron expressions are UTC. If your timezone observes DST, your local schedule will
# shift by an hour seasonally — re-run `./scripts/setup.sh` at the boundary, or
# accept the drift.
# ──────────────────────────────────────────────────────────────────────
[triggers]
crons = ["0 14 * * *", "30 14 * * *", "0 8 * * *"]

# ──────────────────────────────────────────────────────────────────────
# Queues — the capture pipeline. Producers: POST /encode (the CLI hook)
# and the `reflect` MCP tool (all clients). Consumer: writes the episodic
# then encodes it to semantics (worker_encode::process_capture), decoupling
# a fast tool response from the slow Haiku encode. Failed messages retry,
# then land in the DLQ. Create the queues before first deploy:
#   wrangler queues create oneiro-capture
#   wrangler queues create oneiro-capture-dlq
# ──────────────────────────────────────────────────────────────────────
[[queues.producers]]
binding = "CAPTURE_QUEUE"
queue = "oneiro-capture"

[[queues.consumers]]
queue = "oneiro-capture"
# 1, deliberately: worker 0.8 has only batch-level ack/retry, so a batch >1
# would re-deliver succeeded messages on retry and duplicate their episodics
# (create is not idempotent). Captures are infrequent; throughput is a non-issue.
max_batch_size = 1
max_batch_timeout = 10
max_retries = 3
dead_letter_queue = "oneiro-capture-dlq"

# ──────────────────────────────────────────────────────────────────────
# Secrets (set via `wrangler secret put`, not committed):
#
#   CLAUDE_CODE_OAUTH_TOKEN       — Anthropic API key (sk-ant-api*).
#                                   Name is historical; the worker's auth
#                                   is token-type-aware (CLA-117) and routes
#                                   sk-ant-api* to the x-api-key header. Used
#                                   by the nightly loops (CSCC, orient,
#                                   dialectic) to call Haiku 4.5 + Sonnet 4.6
#                                   via the Messages API, billed at API rates.
#   ONEIRO_OAUTH_CLIENT_ID       — generated by setup script.
#   ONEIRO_OAUTH_CLIENT_SECRET   — generated by setup script.
#   ONEIRO_OAUTH_REDIRECT_URIS   — optional; semicolon-separated
#                                   allowlist of OAuth redirect URIs
#                                   (CLA-91 Fix 2). Default covers
#                                   Claude Desktop; add Claude.ai web's
#                                   callback when prompted.
#   ONEIRO_API_KEYS              — optional; semicolon-separated
#                                   role:<argon2-hash> entries for
#                                   embedded clients (CLA-86).
#   ONEIRO_DIALECTIC_DISPATCH    — Stage 3 dispatcher mode. Setup script
#                                   sets "on" for fresh deploys. Override
#                                   to "dry_run" or "off" during burn-in
#                                   or to silence dispatch. Missing or
#                                   unrecognised values fail-closed to
#                                   "dry_run" (CLA-100).
# ──────────────────────────────────────────────────────────────────────
